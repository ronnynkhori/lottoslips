{
  "name": "lottoslips",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && VITE_BASE=/lottoslips/ vite build",
    "deploy": "npm run deploy:pages",
    "deploy:pages": "npm run build:pages && cp dist/index.html dist/404.html && npx --yes gh-pages -d dist -m \"deploy pages\"",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "homepage": "https://ronnynkhori.github.io/lottoslips/",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
